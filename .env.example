# Copier en .env (ignoré par Git) et renseigner depuis le tableau de bord
# Supabase > Project Settings > API. Seules l'URL et la clé publique vont dans
# l'application : aucune autre clé ici.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Version web seulement : clé PUBLIQUE VAPID des rappels (Web Push), voir le
# README. La clé privée ne va jamais ici : uniquement dans les secrets Supabase.
VITE_VAPID_PUBLIC_KEY=

