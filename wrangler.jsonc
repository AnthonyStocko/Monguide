// Hébergement de la version web : projet Cloudflare Workers « monguide »
// (Workers Builds). Fichiers statiques seulement, aucun code serveur.
// Commande de construction à régler dans Cloudflare : npm run build:web
// (dist-web/ ; « npm run build » écrit dist/, le build Android).
{
  "name": "monguide",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist-web",
    // Fichiers servis à leur adresse exacte : /confidentialite.html n'est pas
    // redirigée vers /confidentialite (pages statiques de public/, adresses
    // déclarées sur Google Play et dans rules.js).
    "html_handling": "none",
    // Routage côté application : toute adresse sans fichier renvoie index.html ;
    // un fichier existant est toujours servi tel quel.
    "not_found_handling": "single-page-application"
  }
}
