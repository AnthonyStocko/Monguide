{
  "name": "monguide-api",
  "version": "0.1.0",
  "description": "API REST (Express + MySQL) pour Mon guide - hébergeable sur alwaysdata",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web",
    "install:web": "npm --prefix web install"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
